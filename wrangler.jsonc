// Static assets config for the Cloudflare Workers build connected to this repo.
// Production hosting is Cloudflare Pages (football-career-1vi.pages.dev); this only lets the Workers preview build succeed.
{
  "name": "football-career",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "previews": {}
}
