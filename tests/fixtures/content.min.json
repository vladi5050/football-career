 "events": [
  {
   "id": "coach_bench_after_party",
   "category": "discipline",
   "weight": 10,
   "when": [
    "flag(party) >= 1",
    "rel(coach) < 30"
   ],
   "cast": {
    "coach": "coach",
    "mate": "teammate"
   },
   "variants": [
    {
     "title": "המאמן לא שכח",
     "body": "{coach} קורא לך לחדר. \"שמעתי על המסיבה עם {mate}.\""
    },
    {
     "title": "שיחה בחדר המאמן",
     "body": "{coach} סוגר את הדלת. \"מה היה אתמול בלילה, {first}?\""
    },
    {
     "title": "הודעה קצרה",
     "body": "הודעה מ{coach}: \"תגיע מוקדם מחר. צריך לדבר.\""
    }
   ],
   "options": [
    {
     "id": "apologise",
     "text": "להתנצל ולהבטיח שזה לא יחזור",
     "hint": "המאמן יעריך את זה",
     "effects": [
      "rel(coach) += 8",
      "morale -= 3",
      "memory(coach, apologised, 10)",
      "history(apologised)"
     ],
     "chain": [
      {
       "after": 2,
       "event": "coach_checks_promise"
      }
     ]
    },
    {
     "id": "defy",
     "text": "\"זה הזמן הפרטי שלי\"",
     "effects": [
      "rel(coach) -= 15",
      "fame += 1",
      "flag(defiant) += 1"
     ]
    }
   ],
   "because": "party"
  },
  {
   "id": "coach_checks_promise",
   "category": "discipline",
   "weight": 10,
   "when": [],
   "cast": {},
   "variants": [
    {
     "title": "המאמן בודק",
     "body": "{coach} מסתכל עליך באימון. \"ראיתי שאתה מקפיד.\""
    },
    {
     "title": "מילה טובה",
     "body": "{coach} עוצר אותך במסדרון. \"שמרת על ההבטחה.\""
    }
   ],
   "options": [
    {
     "id": "thanks",
     "text": "להודות לו",
     "effects": [
